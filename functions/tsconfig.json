{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["**/*.ts"],
  // Ten projekt sprawdza WYŁĄCZNIE kod, który leci na Workers — stąd `types` bez Node.
  // Testy działają w Node (node:sqlite, node:fs) i celowo tu nie pasują; sprawdza je vitest.
  "exclude": ["**/*.test.ts"]
}
